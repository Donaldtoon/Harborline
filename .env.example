NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/harborline_simulator
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Set true only when the app is behind Render's HTTPS proxy
COOKIE_SECURE=false
# Required only when creating the first administrator
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_NAME=Demo Administrator
